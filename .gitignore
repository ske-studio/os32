*.d88
*.iso

# パッケージビルド出力
/packages/

# ビルド成果物出力ディレクトリ (kernel.bin / sqlite.bin / vmkernel.lz4 /
# unicode.bin / kernel.elf / kernel.map)
/build/out/

# SDK staging と配布 tarball (make sdk / make sdk-dist の出力)
/build/sdk/
/build/dist/

# ゲームの生成データ (make game-data で game/data/ のスクリプトから作る)
/game/build/

# 派生アセット (make assets-all で assets/ の上流ファイルから生成する)
# 上流 (fonts/ipaex{g,m}.ttf, ipadic/*.csv) と設定 (filetypes, profile) は追跡する。
/assets/fonts/*_subset.ttf
/assets/fonts/*.kcgfont
/assets/fep.db
/assets/fep_s.db
/assets/fep_l.db
/assets/fep.dic

# 特定の生成ファイル
/unicode.bin
/tools/gen_unicode
/tools/lzss_pack

# パッケージ/ログ等
*.log
*.err
*~
*.swp

# Pythonキャッシュ
__pycache__/
*.pyc

# Rust/Cargo ビルド成果物
**/target/

# OS固有のファイル等
Thumbs.db
.DS_Store

